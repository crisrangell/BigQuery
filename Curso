AULA 5
GROUP BY ( vai separar por grupo)
HAVING ( vai especificar o que mostrar nesse grupo)

SELECT titulo_eleitoral_candidato,
sum(valor_receita) as sum_receita,
count(distinct nome_doador) as qt_doador
  FROM `basedosdados.br_tse_eleicoes.receitas_candidato` 
  WHERE ano = 2018 and sigla_uf = 'BA' and cargo = 'governador'
  GROUP BY titulo_eleitoral_candidato
  HAVING qt_doador > 10
  ORDER BY sum_receita desc;



SELECT titulo_eleitoral_candidato,
sum(valor_receita) as sum_receita,
count(distinct nome_doador) as qt_doador,
CASE WHEN sum(valor_receita) > 100000 THEN 'receita alta'
 ELSE 'receita baixa' end as categoria_receita,
  FROM `basedosdados.br_tse_eleicoes.receitas_candidato` 
  WHERE ano = 2018 and sigla_uf = 'BA' and cargo = 'governador'
  GROUP BY titulo_eleitoral_candidato
  ORDER BY sum_receita desc;


